# Copy this file to .env and fill in values as needed.

# OpenAI settings
OPENAI_API_KEY=sk-your-openai-key

# Gateway configuration (safe defaults)
GATEWAY_VERSION=0.1.0
GATEWAY_REQUEST_TIMEOUT_S=15
GATEWAY_MAX_RETRIES=2
GATEWAY_MAX_INPUT_CHARS=4000
GATEWAY_MAX_CONCURRENCY=10

# Providers / Models allowlist (include Claude)
GATEWAY_ALLOWED_PROVIDERS=openai,claude
GATEWAY_ALLOWED_MODELS=gpt-3.5-turbo,claude-3-haiku

# Agent configuration
AGENT_TIMEOUT_S=15
AGENT_MODEL=gpt-3.5-turbo

# Claude (Anthropic) settings
# Put your Anthropic API key here (or use X-ANTHROPIC-API-KEY header)
ANTHROPIC_API_KEY=sk-your-anthropic-key
# Optional alias env name supported by provider
CLAUDE_API_KEY=
# Claude CLI executable path (fallbacks to 'claude' on PATH)
GATEWAY_CLAUDE_CLI_PATH=./scripts/claude_cli.sh
# Default Claude model for CLI
GATEWAY_CLAUDE_MODEL=claude-3-haiku
