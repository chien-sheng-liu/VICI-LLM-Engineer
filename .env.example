# Copy this file to .env and fill in values as needed.

# OpenAI settings
OPENAI_API_KEY=sk-your-openai-key

# Gateway configuration (safe defaults)
GATEWAY_VERSION=0.1.0
GATEWAY_REQUEST_TIMEOUT_S=15
GATEWAY_MAX_RETRIES=2
GATEWAY_MAX_INPUT_CHARS=4000
GATEWAY_MAX_CONCURRENCY=10

# Allow only OpenAI (and mock for tests)
GATEWAY_ALLOWED_PROVIDERS=openai,mock
GATEWAY_ALLOWED_MODELS=gpt-3.5-turbo,mock-01

# Agent configuration
AGENT_TIMEOUT_S=15
AGENT_MODEL=gpt-3.5-turbo
